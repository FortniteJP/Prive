<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- ASP0016: a route handler taking only an HttpContext binds to the RequestDelegate overload
         of MapGet/MapPost, which silently discards the return value and answers with an empty
         body. Cast such handlers to (Delegate). Too easy to miss as a warning. -->
    <WarningsAsErrors>ASP0016</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Discord.Net" Version="3.11.0" />
    <PackageReference Include="MongoDB.Driver" Version="2.19.1" />
  </ItemGroup>

</Project>
