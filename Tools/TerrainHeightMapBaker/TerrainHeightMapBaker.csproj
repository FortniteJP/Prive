<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CUE4Parse" Version="1.2.2.202608" />
    <!-- Only needed for UTexture2D.Decode() - turns a landscape's heightmap texture (which for a
         real cooked ULandscapeHeightfieldCollisionComponent is inaccessible - see the big comment
         at the top of Program.cs) into plain pixel bytes. Same version/feed as CUE4Parse itself. -->
    <PackageReference Include="CUE4Parse-Conversion" Version="1.2.2.202608" />
  </ItemGroup>

</Project>
