<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>pakreader</AssemblyName>
    <RootNamespace>PakReader</RootNamespace>
    <!-- CUE4Parse is a third-party tree; its warnings are not this repo's to fix. -->
    <NoWarn>$(NoWarn);CS8618;CS8600;CS8602;CS8604</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!--
      CUE4Parse lives outside this repo, in the PriveDev tool collection, and is referenced in place
      rather than vendored: it is 60+ projects' worth of code that this repo has no business owning,
      and it is already checked out there. See the memory note [[pak-access]].
    -->
    <ProjectReference Include="..\..\..\PriveDev\CUE4Parse\CUE4Parse\CUE4Parse.csproj" />
    <!--
      For `anim`: decoding a CURRENT-version AnimSequence means decompressing ACL, and the converter
      that does it lives here. It needs the native ACL library next to the binary: in the CUE4Parse
      checkout, check out the ACL submodule, then configure and build CUE4Parse-Natives with CMake
      (Release, x64) and copy builddir\Release\CUE4Parse-Natives.dll into this project's output.
    -->
    <ProjectReference Include="..\..\..\PriveDev\CUE4Parse\CUE4Parse-Conversion\CUE4Parse-Conversion.csproj" />
  </ItemGroup>

</Project>
